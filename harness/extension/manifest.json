{
  "manifest_version": 3,
  "name": "slicc harness content script",
  "version": "1.0.0",
  "key": "",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [{ "resources": ["frame.html"], "matches": ["<all_urls>"] }]
}
