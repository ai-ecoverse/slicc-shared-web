{
  "name": "@ai-ecoverse/slicc-shared-web",
  "version": "0.0.0",
  "description": "Shared Renovate, Biome, TypeScript, lefthook and GitHub Actions configuration, plus the CDP integration-test harness, for SLICC's web repos",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-shared-web.git"
  },
  "engines": {
    "node": ">=24"
  },
  "slicc": {
    "unitSources": [
      "bin",
      "harness",
      "testing",
      "unit"
    ]
  },
  "fledgling": {
    "provider": "github",
    "workflow": "ci.yml",
    "repo": "ai-ecoverse/slicc-shared-web",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    "./biome": "./biome.json",
    "./tsconfig.json": "./tsconfig.json",
    "./lefthook.yml": "./lefthook.yml",
    "./package.json": "./package.json",
    "./mcr.config.mjs": "./mcr.config.mjs",
    "./harness": "./harness/index.mjs",
    "./harness/global": "./harness/global.mjs",
    "./pnpmfile.mjs": "./pnpmfile.mjs",
    "./testing": "./testing/index.mjs"
  },
  "bin": {
    "slicc-agents-md": "bin/slicc-agents-md.sh",
    "slicc-diff-cover": "bin/slicc-diff-cover.sh",
    "slicc-flaky": "bin/slicc-flaky.mjs",
    "slicc-install-hooks": "bin/slicc-install-hooks.mjs",
    "slicc-lint": "bin/slicc-lint.sh",
    "slicc-lint-comments": "bin/slicc-lint-comments.sh",
    "slicc-memory-peak": "bin/slicc-memory-peak.sh",
    "slicc-minidump": "bin/slicc-minidump.mjs",
    "slicc-no-unit-tests": "bin/slicc-no-unit-tests.sh",
    "slicc-unit-cover": "bin/slicc-unit-cover.mjs"
  },
  "files": [
    "bin",
    "biome.json",
    "harness",
    "default.json",
    "lefthook.yml",
    "mcr.config.mjs",
    "tsconfig.json",
    "pnpmfile.mjs",
    "testing",
    "unit"
  ],
  "scripts": {
    "prepare": "node bin/slicc-install-hooks.mjs",
    "lint": "bin/slicc-lint.sh && shellcheck bin/*.sh",
    "pretest": "slicc-cdp install-browser",
    "test": "SLICC_PROFILE=1 node --test --test-global-setup=harness/global.mjs test/integration/*.test.mjs && node test/integration/verify.mjs",
    "test:unit": "mcr -c mcr.config.mjs node --test 'test/unit/**/*.test.mjs'",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-browsers": "1.18.19",
    "@ai-ecoverse/slicc-cdp": "1.42.4",
    "@biomejs/biome": "2.6.2",
    "lefthook": "2.2.2",
    "monocart-coverage-reports": "2.13.2",
    "pnpm": "12.15.0",
    "semantic-release": "25.0.9"
  },
  "peerDependencies": {
    "@ai-ecoverse/slicc-cdp": "*",
    "monocart-coverage-reports": ">=2.13.0 <4",
    "playwright-core": ">=1.50.0"
  },
  "peerDependenciesMeta": {
    "@ai-ecoverse/slicc-cdp": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "dependencies": {
    "acorn": "8.19.0",
    "amaro": "1.2.2"
  }
}
